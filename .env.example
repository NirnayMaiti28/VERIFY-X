# ─── Application ───
APP_NAME=VERIFY-X
APP_VERSION=2.0.0
DEBUG=true

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://verifyx:verifyx_dev@localhost:5432/verifyx
POSTGRES_USER=verifyx
POSTGRES_PASSWORD=verifyx_dev
POSTGRES_DB=verifyx

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── API Keys ───
NEWS_API_KEY=
HF_TOKEN=

# ─── Models ───
TEXT_BASE_MODEL=Qwen/Qwen3-8B
TEXT_ADAPTER=
VISION_BASE_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VISION_ADAPTER=

# ─── Model Mode: local or remote ───
MODEL_MODE=local

# ─── Embedding Model ───
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── MLflow ───
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# ─── Security ───
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT=100/minute
MAX_UPLOAD_SIZE_MB=10

# ─── Logging ───
LOG_LEVEL=INFO
LOG_FORMAT=json
